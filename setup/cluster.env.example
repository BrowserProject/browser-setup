# cluster.env.example - per-cluster configuration template.
#
# Copy to cluster.env and fill in your values, or supply your real file at
# provision time: `provision.sh --cluster-env /path/to/cluster.env`. node-setup
# falls back to THIS template if no cluster.env is present, so a bare checkout
# still runs - but placeholder values (below) will fail any step that uses them.
# Sourced by node-setup after versions.env, before roles/modules.

# Default control-plane Tailscale IP that workers/gateways join through. Pass
# --server <ip> to node-setup / provision.sh to override per run (the burst
# provisioner and cluster bootstrap both do). Set the real value here (or in a
# private cluster.env) for control-plane setup and for manual workers run
# without --server.
K3S_SERVER_IP="<control-plane-tailscale-ip>"

# Control plane runs the k3s default sqlite datastore (single server) with the
# auto_vacuum=INCREMENTAL init + daily vacuum timer.
K3S_DATASTORE="sqlite"
K3S_SERVER_EXTRA_ARGS=()

# Encrypt Kubernetes secrets at rest. Applied on fresh installs only: enabling
# it on an existing server requires the `k3s secrets-encrypt` rotation flow, so
# node-setup passes the flag only when no k3s datastore exists yet.
K3S_SECRETS_ENCRYPTION=1

# Services manifest applied by the control-plane role (from the bundle's
# manifests/ directory; pass it with provision.sh --manifests <dir>).
SERVICES_MANIFEST="prod-services.yaml"

# Replace the stock single-pod CoreDNS with a per-node DaemonSet + NodeLocal
# DNSCache (for a fleet of geo-distributed workers).
COREDNS_DAEMONSET=1

# Workers route Docker (browser workspace) traffic through a Mullvad Tailscale
# exit node with auto-failover; the host itself bypasses the tunnel.
EXITNODE_ROUTING=1

# PostgreSQL major version on the DB node.
PG_MAJOR="18"
PG_DATABASES=("browser_v7" "guard_v6")

# pg_hba client rules (managed block). Deliberately NOT 0.0.0.0/0 and NOT the
# plaintext `password` method: scram-sha-256 only, reachable only over the
# tailnet CGNAT range / private net.
PG_HBA_RULES=(
  "host  browser_v7  browser  100.64.0.0/10  scram-sha-256"
  "host  browser_v7  browser  10.0.0.0/8     scram-sha-256"
  "host  guard_v6    guard    100.64.0.0/10  scram-sha-256"
  "host  guard_v6    guard    10.0.0.0/8     scram-sha-256"
)

# UFW: sources that may reach a node on ANY port. Defaults to the private net +
# the whole tailnet CGNAT range (how admin/SSH access normally arrives). Append
# any specific public admin IP in your real cluster.env, not here.
UFW_TRUSTED_SOURCES=("10.0.0.0/8" "100.64.0.0/10")

# Public ports by role. Only workers/gateways serve public traffic; the
# control plane and DB node expose nothing publicly.
WORKER_PUBLIC_TCP=(80 443)
WORKER_PUBLIC_UDP=()
GATEWAY_PUBLIC_TCP=(80 443)
GATEWAY_PUBLIC_UDP=()
CONTROL_PLANE_PUBLIC_TCP=()
CONTROL_PLANE_PUBLIC_UDP=()
DB_PUBLIC_TCP=()
DB_PUBLIC_UDP=()
