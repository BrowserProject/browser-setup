# versions.env - single source of truth for pinned software versions.
#
# Bumping a value here re-applies the affected steps on the next node-setup run
# (step journal hashes include this file). Upgrades are deliberate git diffs,
# never an accident of when a node was provisioned.
#
# Pins were taken from the running fleet on 2026-07-05 (dev box browserdev).
# Before provisioning a prod node, confirm the prod cluster version with
# `kubectl get nodes` on the prod control plane and align K3S_VERSION.

# k3s: exact release, passed as INSTALL_K3S_VERSION to the official installer.
K3S_VERSION="v1.35.4+k3s1"

# Docker: installed from download.docker.com apt repo, then apt-mark held so
# unattended upgrades can never restart dockerd (which would kill workspaces).
# Empty = install latest at provision time, then hold. Set to a full apt
# version string (see `apt-cache madison docker-ce`) to pin exactly.
DOCKER_CE_VERSION=""

# Tailscale: installed from pkgs.tailscale.com, then apt-mark held (a tailscaled
# restart tears down tailscale0 and wedges flannel; see the flannel watchdog).
# Empty = latest at provision time, then hold.
TAILSCALE_VERSION=""

# The PostgreSQL major version lives in setup/cluster.env (PG_MAJOR=18);
# the hand-configured dev box stays on 17 (wiki/DEV.md).
